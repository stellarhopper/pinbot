# MQTT credentials for the deployment listener.
#
# Copy to .env.mqtt on the Pi and fill in. setup-pi.sh will do this for you.
# chmod 600 — this file is a credential and is gitignored.

# Broker hostname, e.g. abc123.s1.eu.hivemq.cloud
MQTT_BROKER=
# 8883 is MQTT over TLS. Do not use 1883 here; the password would cross the
# internet in the clear.
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=

# Optional. Must match the topic the GitHub workflow publishes to.
MQTT_TOPIC=pinbot/deploy
