# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional. Set to a test server's ID and slash commands sync to that server
# instantly instead of globally (global sync can take up to an hour to appear).
#
# The two are exclusive on purpose: Discord merges a guild's commands with the
# global set, so publishing both would show every command twice. Setting this
# retracts the global set, and unsetting it retracts the guild copy — so the
# switch is just this line, in either direction, followed by a restart.
#
# While it is set, the bot has no commands in any *other* server it is in.
# Leave it unset in production.
DEV_GUILD_ID=

# Optional. Where the SQLite database lives. Default: data/pinball.db
DB_PATH=

# Optional. Enables the photo/score cross-check, which also needs the anthropic
# package (pip install -e '.[vision]') and has to be switched on per server with
# /config vision on. A key without the package, or the reverse, leaves the check
# silently disabled — /config show tells you when that's the case.
ANTHROPIC_API_KEY=
