# Settings for the venue scoreboard listener (display/server.py).
#
# Copy to display/.env on a bare machine, or pass to the container with
# `docker run --env-file`. chmod 600 — this is a credential, and gitignored.
# Real environment variables override anything in this file.

# The same HiveMQ cluster the GitHub deploys use, e.g. abc123.s1.eu.hivemq.cloud
MQTT_BROKER=
# 8883 is MQTT over TLS. The venue only needs this port open *outbound*.
MQTT_PORT=8883

# A login of the display's own — NOT the Pi's. Create it in HiveMQ Cloud under
# Access Management with the "Subscribe" permission only (and, if your plan
# offers topic filters, only on pinbot/scoreboard/#). A laptop left at the
# venue then can't trigger a deploy or overwrite the board if it goes missing.
MQTT_USERNAME=
MQTT_PASSWORD=

# The Discord server whose board to show. Discord → Settings → Advanced →
# Developer Mode, then right-click the server icon → Copy Server ID.
SCOREBOARD_GUILD_ID=

# Optional. Must match the bot's SCOREBOARD_TOPIC if you changed it there.
SCOREBOARD_TOPIC=pinbot/scoreboard

# Optional. Where the page is served. 0.0.0.0 makes it reachable from other
# machines on the venue LAN; 127.0.0.1 if the TV's browser is on this machine.
DISPLAY_HOST=0.0.0.0
DISPLAY_PORT=8080
